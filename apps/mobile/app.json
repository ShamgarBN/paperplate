{
  "expo": {
    "name": "Paperplate",
    "slug": "paperplate",
    "scheme": "paperplate",
    "version": "2.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paperplate.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E6F70",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.paperplate.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Paperplate",
      "shortName": "Paperplate",
      "themeColor": "#2E6F70",
      "backgroundColor": "#F4EDE0",
      "display": "standalone",
      "orientation": "any",
      "lang": "en",
      "description": "A recipe book and meal planner for our household."
    },
    "extra": {
      "supabaseUrl": "https://syoyddsbqsoptpcheuvy.supabase.co",
      "supabaseAnonKey": "sb_publishable_RyHpQRKzMVrN0A4gp-3KTw_HB2Okve7"
    },
    "experiments": {
      "baseUrl": "/paperplate"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-asset"
    ]
  }
}
